<script>
  const isApple = /Mac|iPhone|iPad|iPod/.test(navigator.platform);
  const modKey = isApple ? "⌘" : "Ctrl";

  const buttons =
    document.querySelectorAll<HTMLButtonElement>(".install__copy");

  buttons.forEach((btn) => {
    const group = btn.closest(".install");
    const status = group?.querySelector<HTMLElement>("[data-copy-status]");
    const codeEl = group?.querySelector<HTMLElement>("code");
    let timer: ReturnType<typeof setTimeout>;

    const announce = (msg: string) => {
      if (status) status.textContent = msg;
    };

    const selectCommand = () => {
      if (!codeEl) return;
      const range = document.createRange();
      range.selectNodeContents(codeEl);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    };

    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        /* clipboard unavailable; fall back to manual selection */
      }

      if (copied) {
        btn.classList.add("is-copied");
        announce(`Copied ${text} to clipboard`);
      } else {
        selectCommand();
        announce(`Press ${modKey}+C to copy ${text}`);
      }

      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.classList.remove("is-copied");
        announce("");
      }, 2200);
    });
  });
</script>
