---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import CodePanel from "../components/CodePanel.astro";

const repo = "https://github.com/tylerbutler/tomlet";
const docs = "https://hexdocs.pm/tomlet/";
const hex = "https://hex.pm/packages/tomlet";

const keep = (s: string, kind = "kept") => {
  const tag = kind === "new" ? `<span class="keep-tag">new</span>` : "";
  return `<span class="t-com keep" data-keep="${kind}">${s}${tag}</span>`;
};

const demoIn =
`${keep("# the user&#39;s favorite snack")}
<span class="t-key">snack</span> <span class="t-eq">=</span> <span class="t-str">"tomato"</span>  ${keep("# raw, with salt")}`;

const demoOut =
`${keep("# the user&#39;s favorite snack")}
<span class="t-key">snack</span> <span class="t-eq">=</span> <span class="t-str">"tomato sandwich"</span>  ${keep("# raw, with salt")}`;

const beforeToml =
`<span class="t-com"># package metadata</span>
<span class="t-key">name</span> <span class="t-eq">=</span> <span class="t-str">"tomlet"</span>
<span class="t-key">version</span> <span class="t-eq">=</span> <span class="t-num">0</span>
<span class="t-key">draft</span> <span class="t-eq">=</span> <span class="t-bool">true</span>`;

const editCode =
`<span class="t-kw">let</span> doc <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">set_int</span>(doc, [<span class="t-str">"version"</span>], <span class="t-num">1</span>)
<span class="t-kw">let</span> doc <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">remove</span>(doc, [<span class="t-str">"draft"</span>])
<span class="t-kw">let</span> doc <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">insert_comment_before</span>(
        doc, [<span class="t-str">"version"</span>], <span class="t-str">"first stable release"</span>)`;

const afterToml =
`<span class="t-com"># package metadata</span>
<span class="t-key">name</span> <span class="t-eq">=</span> <span class="t-str">"tomlet"</span>
${keep("# first stable release", "new")}
<span class="t-key">version</span> <span class="t-eq">=</span> <span class="t-num">1</span>`;

const typedAccess =
`<span class="t-kw">let assert</span> <span class="t-fn">Ok</span>(doc) <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">parse</span>(input)

<span class="t-kw">let assert</span> <span class="t-fn">Ok</span>(title)   <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">get_string</span>(doc, [<span class="t-str">"title"</span>])
<span class="t-kw">let assert</span> <span class="t-fn">Ok</span>(version) <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">get_int</span>(doc, [<span class="t-str">"version"</span>])
<span class="t-kw">let assert</span> <span class="t-fn">Ok</span>(enabled) <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">get_bool</span>(doc, [<span class="t-str">"enabled"</span>])

<span class="t-com"># nested keys use the same path syntax</span>
<span class="t-kw">let assert</span> <span class="t-fn">Ok</span>(name) <span class="t-eq">=</span> <span class="t-mod">tomlet</span>.<span class="t-fn">get_string</span>(doc, [<span class="t-str">"pkg"</span>, <span class="t-str">"name"</span>])`;
---

<Layout>
  <!-- ============ NAV ============ -->
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="nav__brand" href="#top" aria-label="tomlet — home">
        <picture class="nav__logo">
          <source srcset="/tomlet-logo.webp" type="image/webp" />
          <img src="/tomlet-logo.png" width="720" height="385" alt="" decoding="async" />
        </picture>
        <span class="nav__word">tomlet</span>
      </a>
      <nav class="nav__links" aria-label="Primary">
        <a class="nav__scroll" href="#how">How it works</a>
        <a class="nav__scroll" href="#ingredients">Ingredients</a>
        <a href={docs}>Docs</a>
        <a class="nav__gh" href={repo} aria-label="tomlet on GitHub">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <div class="hero__copy reveal">
          <picture class="hero__mark">
            <source srcset="/tomlet-logo.webp" type="image/webp" />
            <img
              src="/tomlet-logo.png"
              width="720"
              height="385"
              alt="The tomlet logomark: a folded golden omelette dotted with diced paprika"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
          <p class="hero__kicker"><span>TOML&nbsp;+&nbsp;omelette</span> · a tidy little parser for Gleam</p>
          <h1 class="hero__title">TOML that<br />keeps your<br /><span class="hero__under">comments.</span></h1>
          <p class="hero__lede">
            tomlet parses TOML 1.0.0 into a document that remembers every comment,
            key order, and bit of whitespace. Edit a value, write it back, and the
            rest of the file comes out exactly how the human left it.
          </p>

          <div class="hero__cta">
            <div class="install" role="group" aria-label="Install command">
              <span class="install__prompt" aria-hidden="true">$</span>
              <code id="install-cmd">gleam add tomlet</code>
              <button class="install__copy" data-copy="gleam add tomlet" aria-label="Copy install command">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="install__copied" aria-hidden="true">plated!</span>
              </button>
              <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
            </div>
            <a class="btn btn--ghost" href="#how">See it round-trip ↓</a>
          </div>
        </div>

        <!-- round-trip demo -->
        <figure class="demo reveal" aria-label="A comment surviving an edit">
          <CodePanel label="config.toml" lang="in" class="demo__panel" code={demoIn} />

          <div class="demo__op" aria-hidden="true">
            <span class="demo__op-line"></span>
            <code class="demo__op-call"><span class="t-mod">tomlet</span>.<span class="t-fn">set_string</span>(doc, [<span class="t-str">"snack"</span>], <span class="t-str">"tomato sandwich"</span>)</code>
            <span class="demo__op-arrow">↓</span>
          </div>

          <CodePanel label="config.toml" lang="out" class="demo__panel" code={demoOut} />

          <figcaption class="demo__caption">
            <span class="demo__chip">comments preserved</span>
            Only the value changed. Both comments stayed put.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ PROMISE BAND ============ -->
    <section class="promise">
      <div class="wrap promise__inner">
        <p class="promise__eq"><code><span class="t-fn">parse</span>(s) <span class="t-punct">|&gt;</span> <span class="t-fn">to_string</span> <span class="t-punct">==</span> s</code></p>
        <p class="promise__say">
          An unedited document writes back <em>byte for byte</em>. Comments, key
          order, string style, integer base, CRLF vs LF: all of it survives the
          round trip. No reformatting, no surprises in the diff.
        </p>
      </div>
    </section>

    <!-- ============ EDIT DEMO ============ -->
    <section class="section how" id="how">
      <div class="wrap">
        <div class="how__head flow">
          <p class="eyebrow-mono"># the whole point</p>
          <h2>Edit a value.<br />Leave the file alone.</h2>
          <p class="how__sub measure">
            In the BEAM world, most TOML libraries only read &mdash; and the rare
            one that can write hands you a freshly reformatted file with the
            comments gone. tomlet treats the surrounding text as sacred:
            it changes the bytes you asked for and nothing else.
          </p>
        </div>

        <div class="how__grid">
          <CodePanel label="before · gleam.toml" lang="toml" code={beforeToml} />

          <CodePanel label="three checked edits" lang="gleam" code={editCode} />

          <CodePanel label="after · gleam.toml" lang="toml" code={afterToml} />

          <p class="how__note">
            <span class="how__note-mark" aria-hidden="true">↳</span>
            <span>The <b>package metadata</b> header never moved, <b>name</b> is
            untouched, the new comment landed right where you asked, and
            <b>draft</b> is simply gone.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ INGREDIENTS ============ -->
    <section class="section ingredients" id="ingredients">
      <div class="wrap">
        <div class="ingredients__head flow">
          <h2>Everything you'd want in a<br />round-tripping parser.</h2>
        </div>

        <ul class="recipe" role="list">
          <li class="recipe__item">
            <Logo size={24} class="recipe__mark" decorative />
            <div>
              <h3>Lossless round-trip</h3>
              <p>Whitespace, key order, string style and integer base all survive a
                 write &mdash; edit a value and nothing around it moves.</p>
            </div>
          </li>
          <li class="recipe__item">
            <Logo size={24} class="recipe__mark" decorative />
            <div>
              <h3>Editing you can trust</h3>
              <p>Typed accessors read by key path and every edit returns a
                 <code>Result</code>, so bad paths and type conflicts come back as
                 matchable errors, never panics.</p>
            </div>
          </li>
          <li class="recipe__item">
            <Logo size={24} class="recipe__mark" decorative />
            <div>
              <h3>Spec-correct, on both targets</h3>
              <p>Pure Gleam with no native dependencies &mdash; identical on Erlang and
                 JavaScript, validated against the official <code>toml-test</code> corpora.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============ API TASTE ============ -->
    <section class="section taste">
      <div class="wrap taste__inner">
        <div class="taste__copy flow">
          <h2>Pull out the value<br />you came for.</h2>
          <p class="measure">
            Typed accessors take a key path and hand back exactly the type you
            asked for, including dates and times as opaque values with lexical
            <code>*_to_string</code> helpers. Mismatch a type and you get a clear,
            matchable error instead of a guess.
          </p>
          <div class="taste__links">
            <a class="btn btn--primary" href={docs}>Read the docs</a>
            <a class="btn btn--ghost" href={repo}>Browse the source</a>
          </div>
        </div>

        <CodePanel label="typed access" lang="gleam" class="taste__panel" code={typedAccess} />
      </div>
    </section>

    <!-- ============ WHY ============ -->
    <section class="section why">
      <div class="wrap why__inner">
        <div class="why__head flow">
          <p class="eyebrow-mono"># why it exists</p>
          <h2>The BEAM didn't have one.</h2>
        </div>
        <div class="why__body flow measure">
          <p>
            No existing Erlang, Elixir or Gleam TOML library round-trips comments
            &mdash; they parse into plain maps and throw the comments away. Most can
            only read; the few that can write give you back a reformatted file. If
            you wanted to bump a version in <code>gleam.toml</code> or rewrite a
            <code>pyproject.toml</code> as a build step without nuking the author's
            notes, you were out of luck.
          </p>
          <p>
            tomlet fills that gap. It's a fresh library with an AST built from the
            start for lossless round-trip, inspired by Rust's
            <a href="https://docs.rs/toml_edit">toml_edit</a> and Python's
            <a href="https://github.com/python-poetry/tomlkit">tomlkit</a>, now
            with a friendly Gleam accent.
          </p>

          <div class="why__cta">
            <div class="install install--dark" role="group" aria-label="Install command">
              <span class="install__prompt" aria-hidden="true">$</span>
              <code>gleam add tomlet</code>
              <button class="install__copy" data-copy="gleam add tomlet" aria-label="Copy install command">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="install__copied" aria-hidden="true">plated!</span>
              </button>
              <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
            </div>
            <a class="why__cta-docs" href={docs}>Read the docs <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="foot">
    <div class="wrap foot__inner">
      <div class="foot__brand">
        <a class="foot__mark" href="#top" aria-label="tomlet — back to top">
          <picture class="foot__logo">
            <source srcset="/tomlet-logo.webp" type="image/webp" />
            <img src="/tomlet-logo.png" width="720" height="385" alt="" decoding="async" />
          </picture>
          <span>tomlet</span>
        </a>
        <p class="foot__tag">Round-tripping TOML for Gleam. Made with butter.</p>
      </div>

      <div class="foot__cols">
        <div class="foot__col">
          <h4>Get it</h4>
          <div class="install foot__install" role="group" aria-label="Install command">
            <code>gleam add tomlet</code>
            <button class="install__copy" data-copy="gleam add tomlet" aria-label="Copy install command">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span class="install__copied" aria-hidden="true">✓</span>
            </button>
            <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
          </div>
          <a href={hex}>hex.pm/packages/tomlet</a>
        </div>
        <div class="foot__col">
          <h4>Learn</h4>
          <a href={docs}>API documentation</a>
          <a href="https://toml.io/en/v1.0.0">TOML 1.0.0 spec</a>
        </div>
        <div class="foot__col">
          <h4>Source</h4>
          <a href={repo}>GitHub repository</a>
          <a href={`${repo}/blob/main/DEV.md`}>Contributing</a>
        </div>
      </div>
    </div>
    <div class="wrap foot__base">
      <span>Dual-licensed under MIT &amp; Apache-2.0.</span>
      <span>Built by <a href="https://github.com/tylerbutler">@tylerbutler</a>.</span>
    </div>
  </footer>
</Layout>

<style>
  /* ---------- NAV ---------- */
  .nav {
    position: sticky; top: 0; z-index: var(--z-nav);
    background: oklch(0.971 0.010 85 / 0.82);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--shell-line);
  }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; height: 4.1rem; }
  .nav__brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--ink); }
  .nav__logo { display: flex; flex: none; }
  .nav__logo img { height: 1.9rem; width: auto; display: block; }
  .nav__word { font-weight: 760; font-size: 1.3rem; letter-spacing: -0.04em; }
  .nav__links { display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 1.7rem); }
  .nav__links a { color: var(--ink); text-decoration: none; font-weight: 520; font-size: 0.98rem; }
  .nav__links a:hover { color: var(--paprika-ink); }
  .nav__scroll { display: none; }
  .nav__gh { display: inline-flex; }
  @media (min-width: 720px) { .nav__scroll { display: inline; } }

  /* ---------- HERO ---------- */
  .hero { position: relative; padding-block: clamp(2.5rem, 1rem + 7vw, 6rem) clamp(3rem, 1rem + 8vw, 7rem); overflow: hidden; }
  .hero__mark {
    display: block;
    width: clamp(112px, 6vw + 84px, 168px);
    margin-bottom: clamp(1.1rem, 2vw, 1.6rem);
    filter: drop-shadow(0 14px 16px oklch(0.55 0.12 70 / 0.28));
  }
  .hero__mark img {
    display: block; width: 100%; height: auto;
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__mark img { animation: plate 0.9s var(--ease-out-expo) 0.08s both; }
    @keyframes plate {
      from { opacity: 0; transform: translateY(10px) scale(0.92) rotate(-2deg); }
      to   { opacity: 1; transform: none; }
    }
  }
  .hero__bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(120% 90% at 88% -10%, var(--yolk) 0%, oklch(0.86 0.13 82) 38%, transparent 70%),
      linear-gradient(180deg, oklch(0.97 0.03 85) 0%, var(--eggshell) 60%);
  }
  .hero__inner {
    display: grid; gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 940px) {
    .hero__inner { grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); }
  }
  .hero__kicker {
    font-family: var(--font-mono); font-size: 0.82rem; font-weight: 500;
    color: var(--ink-soft); margin-bottom: 1.1rem; letter-spacing: -0.01em;
  }
  .hero__kicker span {
    background: var(--ink); color: var(--yolk);
    padding: 0.2em 0.6em; border-radius: var(--radius-pill); margin-right: 0.4em;
    font-weight: 600;
  }
  .hero__title {
    font-size: var(--step-5); line-height: 0.96; letter-spacing: -0.045em;
    margin-bottom: 1.3rem;
  }
  .hero__under { position: relative; white-space: nowrap; }
  .hero__under::after {
    content: ""; position: absolute; left: -0.04em; right: -0.04em; bottom: 0.06em; height: 0.34em;
    background: var(--yolk); z-index: -1; border-radius: 3px;
    transform: rotate(-1.2deg);
  }
  .hero__lede { font-size: var(--step-1); color: var(--ink-soft); max-width: 34ch; line-height: 1.45; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }

  .install {
    display: inline-flex; align-items: center; gap: 0.7rem;
    background: var(--ink); color: var(--eggshell);
    padding: 0.7rem 0.7rem 0.7rem 1.1rem; border-radius: var(--radius-pill);
    font-family: var(--font-mono); font-size: 0.98rem;
  }
  .install__prompt { color: var(--yolk); font-weight: 700; }
  .install code { color: var(--eggshell); }
  .install__copy {
    position: relative; display: inline-grid; place-items: center;
    width: 2.1rem; height: 2.1rem; border: none; border-radius: 50%;
    background: var(--skillet-2); color: var(--eggshell); cursor: pointer;
    transition: background-color 0.15s var(--ease-out-quart);
  }
  .install__copy:hover { background: var(--paprika); color: var(--ink); }
  .install__copied {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: var(--chive-chip); color: var(--ink); border-radius: 50%;
    font-family: var(--font-display); font-weight: 700; font-size: 0.62rem;
    opacity: 0; transform: scale(0.6); pointer-events: none;
    transition: opacity 0.18s, transform 0.18s var(--ease-out-expo);
  }
  .install__copy.is-copied .install__copied { opacity: 1; transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .install__copied { transition: opacity 0.01ms; transform: none; }
    .install__copy.is-copied .install__copied { transform: none; }
  }

  /* round-trip demo */
  .demo { display: grid; gap: 0; }
  .demo__op { display: grid; justify-items: center; gap: 0.5rem; padding-block: 0.9rem; position: relative; }
  .demo__op-line { width: 2px; height: 0.7rem; background: var(--shell-line); }
  .demo__op-call {
    font-family: var(--font-mono); font-size: 0.78rem;
    background: var(--ink); color: var(--eggshell);
    padding: 0.5rem 0.85rem; border-radius: var(--radius-pill);
    box-shadow: 0 8px 22px -12px oklch(0.22 0.03 60 / 0.7);
    overflow-x: auto; max-width: 100%; white-space: nowrap;
  }
  .demo__op-arrow { color: var(--yolk-deep); font-weight: 700; line-height: 0.5; }
  .demo__caption {
    margin-top: 1rem; font-size: 0.95rem; color: var(--ink-soft);
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; justify-content: center;
  }
  .demo__chip {
    display: inline-flex; align-items: center; gap: 0.4em;
    background: var(--chive-chip); color: var(--ink); font-weight: 640; font-size: 0.8rem;
    padding: 0.25em 0.7em; border-radius: var(--radius-pill);
  }
  .demo__chip::before { content: ""; width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--ink); }

  /* preserved-comment marker inside code */
  :global(.t-com.keep) {
    position: relative;
    background: oklch(0.58 0.10 145 / 0.16);
    border-radius: 4px;
    padding: 0.05em 0.3em;
    box-shadow: inset 2px 0 0 var(--chive);
  }
  :global(.t-com.keep[data-keep="new"]) {
    background: oklch(0.62 0.19 40 / 0.18);
    box-shadow: inset 2px 0 0 var(--paprika);
  }
  :global(.keep-tag) {
    margin-left: 0.6em;
