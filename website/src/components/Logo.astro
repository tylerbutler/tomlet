---
interface Props {
  size?: number;
  class?: string;
  title?: string;
  decorative?: boolean;
}
const {
  size = 36,
  class: cls = "",
  title = "tomlet",
  decorative = false,
} = Astro.props;

const a11y = decorative
  ? { "aria-hidden": "true" }
  : { role: "img", "aria-label": title };
---

<svg
  class={`omelette ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  {...a11y}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- folded omelette body -->
  <path
    d="M5.5 31.5C5.5 17.8 16.4 8.5 24 8.5C31.6 8.5 42.5 17.8 42.5 31.5C42.5 34 40.4 35.6 37.2 35.6H10.8C7.6 35.6 5.5 34 5.5 31.5Z"
    fill="var(--yolk)"
    stroke="var(--ink)"
    stroke-width="2.4"
    stroke-linejoin="round"
  />
  <!-- the fold / crease, with a peek of soft inside -->
  <path
    d="M11 27.5C16 23.5 20 25.5 24 25.5C28 25.5 32 23.5 37 27.5"
    stroke="var(--yolk-deep)"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <!-- runny-yolk peek -->
  <circle cx="24" cy="19.5" r="4.1" fill="var(--paprika)" stroke="var(--ink)" stroke-width="2" />
  <!-- chive flecks -->
  <rect x="14.5" y="30.4" width="3.4" height="1.7" rx="0.85" fill="var(--chive)" transform="rotate(-18 14.5 30.4)" />
  <rect x="29.5" y="31" width="3.4" height="1.7" rx="0.85" fill="var(--chive)" transform="rotate(22 29.5 31)" />
</svg>

<style>
  .omelette { display: block; flex: none; }
</style>
